# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — TEST credentials
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_PLAN_INTERNO_ID=
MP_PLAN_RESIDENTE_ID=
# Tramo básico (UFBI). Sin estas dos, getPlan() devuelve null y el checkout
# responde `invalid plan` aunque la tarjeta exista en la landing.
MP_PLAN_UFBI_ID=
MP_PLAN_UFBI_ANUAL_ID=
MP_PLAN_VISITANTE_ID=
MP_PLAN_RESIDENTE_12_ID=
MP_PLAN_ESPECIALISTA_24_ID=
MP_WEBHOOK_SECRET=

# MedGO IA (Claude Haiku 5.5). La key va SOLO en .env.local y en Vercel (este
# archivo se sube a git: aquí siempre vacía). Nunca con prefijo NEXT_PUBLIC_.
# Sin ella /api/ia/chat responde 503 «no_configurada».
ANTHROPIC_API_KEY=
# `1` abre la IA a los planes de pago; vacío = solo el admin («Próximamente»).
IA_ABIERTA=
# Gasto máximo de toda la app en un día (US$); al pasarlo la IA se apaga sola.
IA_TOPE_DIARIO_USD=5

# Copia del Libro de Reclamaciones por correo (opcional)
RESEND_API_KEY=
RESEND_FROM=

# Domicilio fiscal del titular (solo en la hoja del Libro de Reclamaciones; nunca en el repo)
PROVEEDOR_DOMICILIO=
